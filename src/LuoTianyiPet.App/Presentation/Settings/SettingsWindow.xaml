        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="18,9" Background="#FCFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10.5" Text="更改会在保存后立即生效" />
                <Button Grid.Column="1" AutomationProperties.Name="保存桌宠设置" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" Content="保存并关闭" />
            </Grid>
        </Border>
    </Grid>
</Window>
