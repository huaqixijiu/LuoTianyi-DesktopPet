<Window x:Class="LuoTianyiPet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠设置" Icon="/assets/app/luotianyi-pet.ico"
        Width="600" Height="664" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F7FBFD"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" Loaded="OnLoaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Controls/FloatGlassResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <!-- 本地键名保留，色值对齐浅玻璃令牌家族色相 -->
        <SolidColorBrush x:Key="Primary" Color="#FF66CCFF" />
        <SolidColorBrush x:Key="PrimaryDark" Color="#FF176A90" />
        <SolidColorBrush x:Key="Text" Color="#FF123E56" />
        <SolidColorBrush x:Key="Muted" Color="#FF5C7484" />
        <SolidColorBrush x:Key="Line" Color="#33176A90" />
        <SolidColorBrush x:Key="SettingsHoverBrush" Color="#1266CCFF" />
        <SolidColorBrush x:Key="SettingsCheckedBrush" Color="#2166CCFF" />
        <SolidColorBrush x:Key="SettingsCardHoverBrush" Color="#F2F9FE" />
        <SolidColorBrush x:Key="SettingsTileBrush" Color="#1E66CCFF" />
        <SolidColorBrush x:Key="SettingsSwitchOffBrush" Color="#D9E4EA" />

        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}" /></Style>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="PageDescription" TargetType="TextBlock"><Setter Property="Margin" Value="0,3,0,12" /><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="11" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock"><Setter Property="Margin" Value="2,2,4,5" /><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="CardHeader" TargetType="TextBlock"><Setter Property="Margin" Value="11,9,11,2" /><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="OptionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="OptionDescription" TargetType="TextBlock"><Setter Property="Margin" Value="0,2,0,0" /><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="11" /><Setter Property="TextWrapping" Value="Wrap" /></Style>

        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="NavigationItem" TargetType="RadioButton">
            <Setter Property="Height" Value="44" /><Setter Property="Margin" Value="8,1" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Primary}" CornerRadius="0,2,2,0" Opacity="0" />
                            <ContentPresenter Margin="14,0,8,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsHoverBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource PrimaryDark}" /><Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsCheckedBrush}" /><Setter TargetName="Bar" Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Primary}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="48" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Row" Padding="10,6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentPresenter Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Width="42" Height="23" VerticalAlignment="Center">
                            <Border x:Name="Track" Background="{StaticResource SettingsSwitchOffBrush}" CornerRadius="12" />
                            <Ellipse x:Name="Thumb" Width="17" Height="17" Margin="3" HorizontalAlignment="Left" Fill="White" />
                        </Grid>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SettingsHoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource Primary}" /><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Primary}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Primary}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SourceChip" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Chip" Padding="9,6" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter VerticalAlignment="Center" />
                        <Border x:Name="CheckBadge" Width="16" Height="16" Margin="8,0,0,0" Background="{StaticResource Primary}" CornerRadius="8" Opacity="0" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Segoe MDL2 Assets" FontSize="9" Text="&#xE73E;" />
                        </Border>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{StaticResource SettingsCardHoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="{StaticResource SettingsHoverBrush}" /><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Primary}" /><Setter TargetName="CheckBadge" Property="Opacity" Value="1" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryDark}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SelectionCard" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="82" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="Padding" Value="11,9" />
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Card" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                    <Grid><ContentPresenter Margin="0,0,18,0" VerticalAlignment="Center" />
                        <Border x:Name="Badge" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Primary}" CornerRadius="9" Opacity="0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE73E;" />
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource SettingsCardHoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource SettingsHoverBrush}" /><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Primary}" /><Setter TargetName="Badge" Property="Opacity" Value="1" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryDark}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="MusicPreviewCard" TargetType="RadioButton">
            <Setter Property="Height" Value="112" /><Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Card" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                    <Grid>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="RadioRing" Width="16" Height="16" Margin="0,3,3,0" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="8" />
                        <Border x:Name="Badge" Width="18" Height="18" Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Primary}" CornerRadius="9" Opacity="0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE73E;" />
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource SettingsCardHoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource SettingsHoverBrush}" /><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Primary}" /><Setter TargetName="Badge" Property="Opacity" Value="1" /><Setter TargetName="RadioRing" Property="Opacity" Value="0" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryDark}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryDark}" /><Setter Property="Background" Value="{StaticResource SettingsHoverBrush}" />
            <Setter Property="BorderBrush" Value="#4D66CCFF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsCheckedBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryDark}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}" />
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="MinWidth" Value="118" /><Setter Property="Height" Value="38" /><Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="{StaticResource FloatAccentInkBrush}" /><Setter Property="BorderBrush" Value="{StaticResource FloatAccentDeepBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource FloatAccentDeepBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FloatAccentDeepBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShortcutInput" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryDark}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsCardHoverBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryDark}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="28" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid>
                    <Track x:Name="PART_Track" Orientation="Horizontal">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{StaticResource FloatAccentBrush}" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{StaticResource SettingsSwitchOffBrush}" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="Halo" Width="22" Height="22" Fill="{StaticResource SettingsHoverBrush}" Opacity="0" />
                                <Ellipse Width="14" Height="14" Fill="White" Stroke="{StaticResource FloatAccentInkBrush}" StrokeThickness="1.5" />
                            </Grid>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Halo" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7" /><Setter Property="Background" Value="Transparent" /><Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Width="7" Margin="0,3" Background="Transparent">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinHeight="30"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#8EB8CBD4" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="154" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Background="#F1F8FC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="83" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="14,14,8,8" Orientation="Horizontal">
                    <Border Width="42" Height="42" Margin="0,0,9,0" Background="{StaticResource SettingsTileBrush}" CornerRadius="12"><Image Margin="3" Source="/assets/app/luotianyi-pet.png" Stretch="Uniform" /></Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock FontSize="15" FontWeight="SemiBold" Text="洛天依桌宠" /><TextBlock Margin="0,2,0,0" Foreground="{StaticResource Muted}" FontSize="10.5" Text="设置" /></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="GeneralNavigationRadioButton" GroupName="SettingsNavigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="常规设置" Tag="General" Checked="OnNavigationChecked"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,10,0"><Canvas Width="24" Height="24"><Path Data="M4,6.5 H20 M4,12 H20 M4,17.5 H20" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Ellipse Canvas.Left="6.9" Canvas.Top="4.4" Width="4.2" Height="4.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><Ellipse Canvas.Left="12.9" Canvas.Top="9.9" Width="4.2" Height="4.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><Ellipse Canvas.Left="4.9" Canvas.Top="15.4" Width="4.2" Height="4.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Canvas></Viewbox><TextBlock FontSize="13" FontWeight="SemiBold" Text="常规" /></StackPanel></RadioButton>
                    <RadioButton x:Name="MusicNavigationRadioButton" GroupName="SettingsNavigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="音乐设置" Tag="Music" Checked="OnNavigationChecked"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,10,0"><Canvas Width="24" Height="24"><Path Data="M9,17.5 V6.5 L18,4.5 V15.5" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Ellipse Canvas.Left="4.6" Canvas.Top="15.2" Width="4.6" Height="4.6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><Ellipse Canvas.Left="13.6" Canvas.Top="13.2" Width="4.6" Height="4.6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Canvas></Viewbox><TextBlock FontSize="13" FontWeight="SemiBold" Text="音乐" /></StackPanel></RadioButton>
                    <RadioButton x:Name="NotificationNavigationRadioButton" GroupName="SettingsNavigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="通知设置" Tag="Notification" Checked="OnNavigationChecked"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,10,0"><Canvas Width="24" Height="24"><Path Data="M12,4.5 C9.2,4.5 7.6,6.6 7.6,9.3 C7.6,13 6.2,14.6 6.2,14.6 H17.8 C17.8,14.6 16.4,13 16.4,9.3 C16.4,6.6 14.8,4.5 12,4.5 Z M10.4,17.6 A1.7,1.7 0 0 0 13.6,17.6" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox><TextBlock FontSize="13" FontWeight="SemiBold" Text="通知" /></StackPanel></RadioButton>
                    <RadioButton x:Name="AboutNavigationRadioButton" GroupName="SettingsNavigation" Style="{StaticResource NavigationItem}" AutomationProperties.Name="关于洛天依桌宠" Tag="About" Checked="OnNavigationChecked"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,10,0"><Canvas Width="24" Height="24"><Ellipse Canvas.Left="4.5" Canvas.Top="4.5" Width="15" Height="15" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" /><Path Data="M12,11 V16.2" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Ellipse Canvas.Left="11" Canvas.Top="7.2" Width="2" Height="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Canvas></Viewbox><TextBlock FontSize="13" FontWeight="SemiBold" Text="关于" /></StackPanel></RadioButton>
                </StackPanel>
                <Grid Grid.Row="2" Margin="10,8,8,8" IsHitTestVisible="False">
                    <TextBlock x:Name="PageSpeechText" Margin="7,0,2,116" VerticalAlignment="Bottom" Foreground="{StaticResource FloatAccentInkBrush}" FontSize="13" FontWeight="SemiBold" LineHeight="21" Text="今天也，&#x0a;一起加油吧～" TextWrapping="Wrap" />
                    <Image x:Name="PageArtworkImage" Width="132" Height="116" HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.Name="常规页面装饰：我推" Source="/assets/ui/settings-sidebar-general.png" Stretch="Uniform" Opacity="0.95" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="White">
            <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,16,16,16">
                    <TextBlock Style="{StaticResource PageTitle}" Text="常规" /><TextBlock Style="{StaticResource PageDescription}" Text="管理桌宠的启动、显示和日常互动。" />
                    <Border Style="{StaticResource GroupCard}"><StackPanel>
                        <TextBlock Style="{StaticResource CardHeader}" Text="行为" />
                        <CheckBox x:Name="StartWithWindowsCheckBox" AutomationProperties.Name="登录 Windows 后自动启动洛天依桌宠" Checked="OnSettingChanged" Unchecked="OnSettingChanged"><StackPanel><TextBlock Style="{StaticResource OptionTitle}" Text="开机自动启动" /><TextBlock Style="{StaticResource OptionDescription}" Text="登录 Windows 后自动运行桌宠" /></StackPanel></CheckBox>
                        <Separator Margin="10,0" Background="{StaticResource FloatDividerBrush}" />
                        <CheckBox x:Name="AlwaysOnTopCheckBox" AutomationProperties.Name="桌宠始终置顶" Checked="OnSettingChanged" Unchecked="OnSettingChanged"><StackPanel><TextBlock Style="{StaticResource OptionTitle}" Text="始终置顶" /><TextBlock Style="{StaticResource OptionDescription}" Text="保持桌宠显示在其他普通窗口上方" /></StackPanel></CheckBox>
                        <Separator Margin="10,0" Background="{StaticResource FloatDividerBrush}" />
