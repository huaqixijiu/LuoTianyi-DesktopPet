<Window x:Class="LuoTianyiPet.App.PetQuickPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天依常用功能" Width="288" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources><ResourceDictionary Source="QuickPanelResources.xaml" /></Window.Resources>
    <Border Style="{StaticResource PanelSurface}" RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <ScaleTransform x:Name="PanelEntranceScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <StackPanel>
            <!-- 头部：品牌点、标题与隐藏入口，右侧日历和闹钟入口 -->
            <Grid Margin="2,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6"
                             Height="6"
                             Margin="0,0,8,0"
                             Fill="{StaticResource FloatAccentBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="天依 · 常用功能" />
                    <Button x:Name="HidePetButton"
                            Style="{StaticResource PanelIconButton}"
                            Focusable="False"
                            Margin="5,0,0,0"
                            Click="OnHidePetClick"
                            ToolTip="隐藏桌宠（从托盘左键即可找回天依）"
                            AutomationProperties.Name="隐藏桌宠">
                        <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M2.5,12 C5,8.5 8,6.5 12,6.5 C16,6.5 19,8.5 21.5,12 C19,15.5 16,17.5 12,17.5 C8,17.5 5,15.5 2.5,12 Z M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" /></Canvas></Viewbox>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CalendarButton"
                            Style="{StaticResource PanelIconButton}"
                            Focusable="False"
                            Click="OnCalendarClick"
                            ToolTip="打开日历"
                            AutomationProperties.Name="日历">
                        <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M7,6 H17 A2.5,2.5 0 0 1 19.5,8.5 V17 A2.5,2.5 0 0 1 17,19.5 H7 A2.5,2.5 0 0 1 4.5,17 V8.5 A2.5,2.5 0 0 1 7,6 Z M4.5,10 H19.5 M8.5,4 V8 M15.5,4 V8" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                    </Button>
                    <Button x:Name="AlarmButton"
                            Style="{StaticResource PanelIconButton}"
                            Focusable="False"
                            Margin="4,0,0,0"
                            Click="OnAlarmClick"
                            ToolTip="打开闹钟"
                            AutomationProperties.Name="闹钟">
                        <Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="M5.2,8.8 A4,4 0 0 1 8.8,5.2 M15.2,5.2 A4,4 0 0 1 18.8,8.8" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Ellipse Canvas.Left="5" Canvas.Top="6" Width="14" Height="14" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" /><Path Data="M12,9.5 V13 L14.7,15" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Height="1" Background="{StaticResource FloatDividerBrush}" Margin="10,4" />
            <CheckBox x:Name="LockPositionCheckBox" Click="OnLockClick" ToolTip="防止误拖，仍可摸头、点击和双击换装">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Path Data="M6.5,11 H17.5 V19.5 H6.5 Z M9,11 V8.5 A3,3 0 0 1 15,8.5 V11" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                    <TextBlock Text="锁定位置" VerticalAlignment="Center" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="TopmostCheckBox" Click="OnTopmostClick">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Path Data="M12,4.5 L19,11.5 H15 V19.5 H9 V11.5 H5 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                    <TextBlock Text="始终置顶" VerticalAlignment="Center" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="MusicIslandsCheckBox" Click="OnMusicClick" ToolTip="开启后悬停显示歌名和音乐控制；关闭后全部隐藏">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Path Data="M7,18.5 V10.5 M12,18.5 V5.5 M17,18.5 V12.5" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                    <TextBlock Text="显示音乐悬浮岛" VerticalAlignment="Center" />
                </StackPanel>
            </CheckBox>
            <Border Height="1" Background="{StaticResource FloatDividerBrush}" Margin="10,4" />
            <!-- 显示大小：左标签 + 右对齐一体步进器 -->
            <Grid Margin="10,0" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12" Text="显示大小" VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Width="104"
                        Height="32"
                        CornerRadius="9"
                        BorderBrush="{StaticResource FloatControlBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DecreaseScaleButton"
                                Style="{StaticResource PanelStepButton}"
                                Content="−"
                                FontSize="16"
                                Click="OnDecreaseClick"
                                AutomationProperties.Name="缩小桌宠" />
                        <TextBlock x:Name="ScaleValueText"
                                   Grid.Column="1"
                                   FontSize="12"
                                   Foreground="{StaticResource FloatAccentDeepBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <Button x:Name="IncreaseScaleButton"
                                Grid.Column="2"
                                Style="{StaticResource PanelStepButton}"
                                Content="+"
                                FontSize="16"
                                Click="OnIncreaseClick"
                                AutomationProperties.Name="放大桌宠" />
                    </Grid>
                </Border>
            </Grid>
            <Border Height="1" Background="{StaticResource FloatDividerBrush}" Margin="10,4" />
            <Button x:Name="SettingsButton" Click="OnSettingsClick">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Path Data="M4.5,8.5 H19.5 M4.5,15.5 H19.5 M9.5,6.5 V10.5 M14.5,13.5 V17.5" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                    <TextBlock Text="设置" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="ExitPetButton"
                    Style="{StaticResource PanelDangerButton}"
                    Click="OnExitPetClick">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Path Data="M10.5,4.5 H5 V19.5 H10.5 M14,8.5 L18,12 L14,15.5 M18,12 H9" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                    <TextBlock Text="退出桌宠" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
