<Window x:Class="LuoTianyiPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洛天依桌宠"
        Width="196"
        Height="306"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        Loaded="OnLoaded"
        Closed="OnClosed"
        AllowDrop="True"
        DragEnter="OnFileDragEnter"
        DragOver="OnFileDragOver"
        DragLeave="OnFileDragLeave"
        Drop="OnFileDrop"
        LostMouseCapture="OnLostMouseCapture"
        MouseEnter="OnRootMouseEnter"
        MouseLeave="OnRootMouseLeave"
        MouseRightButtonUp="OnPetMouseRightButtonUp"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseMove="OnMouseMove">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Controls/FloatGlassResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <ControlTemplate x:Key="MediaButtonTemplate" TargetType="Button">
            <Grid x:Name="ButtonRoot"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform />
                </Grid.RenderTransform>
                <Border Margin="-2"
                        Background="Transparent" />
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="18" />
                <Border x:Name="HoverFace"
                        CornerRadius="18"
                        Background="{StaticResource FloatHoverBrush}"
                        Opacity="0"
                        IsHitTestVisible="False" />
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverFace"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverFace"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ButtonRoot" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.42" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MediaPrimaryButtonTemplate" TargetType="Button">
            <Grid x:Name="ButtonRoot"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform />
                </Grid.RenderTransform>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="22" />
                <Border x:Name="HoverFace"
                        CornerRadius="22"
                        Background="#FF35B8F2"
                        Opacity="0"
                        IsHitTestVisible="False" />
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverFace"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverFace"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ButtonRoot" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.42" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="MediaIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource FloatAccentInkBrush}" />
            <Setter Property="Template" Value="{StaticResource MediaButtonTemplate}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource FloatAccentDeepBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MediaPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource FloatAccentBrush}" />
            <Setter Property="BorderBrush" Value="#D9FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template" Value="{StaticResource MediaPrimaryButtonTemplate}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloudMusicVerticalVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="116" />
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="IsDirectionReversed" Value="False" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="30" Height="116">
                            <Border Width="6"
                                    Margin="0,9"
                                    HorizontalAlignment="Center"
                                    Background="#FFDCEAF1"
                                    CornerRadius="3" />
                            <Track x:Name="PART_Track"
                                   Margin="0,9"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Width="6"
                                                        Background="#FF66CCFF"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"
                                                         Stroke="#FF35B8F2"
                                                         StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Width="14" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid x:Name="PetVisual"
              Margin="8,60,8,66"
              RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetDirectionTransform" ScaleX="1" ScaleY="1" />
                    <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PetShakeTransform" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="PetImage"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SizeChanged="OnPetImageSizeChanged"
                   SnapsToDevicePixels="True"
                   Stretch="Fill" />

            <Canvas x:Name="CrystalLongIdleDecorationLayer"
                    Panel.ZIndex="2"
                    Width="{Binding ActualWidth, ElementName=PetImage}"
                    Height="{Binding ActualHeight, ElementName=PetImage}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Image x:Name="CrystalLongIdleDecorationImage"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5"
                       SnapsToDevicePixels="True"
                       Stretch="Fill" />
            </Canvas>

            <Border x:Name="FallbackSurface"
                    Width="180"
                    Height="180"
                    Padding="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#E833B9D0"
                    BorderBrush="#EEFFFFFF"
                    BorderThickness="3"
                    CornerRadius="90"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="34"
                               Text="♪" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="动画素材暂时不可用" />
                </StackPanel>
            </Border>

            <Canvas x:Name="BodyHitDebugOverlay"
                    Panel.ZIndex="3"
                    Width="{Binding ActualWidth, ElementName=PetImage}"
                    Height="{Binding ActualHeight, ElementName=PetImage}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>

        <Ellipse x:Name="MusicTransitionFlash"
                 Panel.ZIndex="2"
                 Width="150"
                 Height="150"
                 Margin="8,60,8,66"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 IsHitTestVisible="False"
                 Opacity="0"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#F8FFFFFF" />
                    <GradientStop Offset="0.42" Color="#D85FE7F2" />
                    <GradientStop Offset="0.76" Color="#704ACFDF" />
                    <GradientStop Offset="1" Color="#004ACFDF" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="MusicTransitionFlashScale" ScaleX="0.35" ScaleY="0.35" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Border x:Name="FeedbackBubble"
                Panel.ZIndex="6"
                MaxWidth="250"
                Margin="5,6,5,0"
                Padding="7,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#FFF7FCFF"
                BorderBrush="#B866CCFF"
                BorderThickness="1"
                CornerRadius="14"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="22"
                        Height="22"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#2432B9F2"
                        CornerRadius="11">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#0878A9"
                               FontSize="11"
                               FontWeight="Bold"
                               Text="依" />
                </Border>
                <TextBlock x:Name="FeedbackBubbleText"
                           Grid.Column="1"
                           Margin="3,0,2,0"
                           VerticalAlignment="Center"
                           Foreground="#173F54"
                           FontSize="11.5"
                           TextAlignment="Left"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border x:Name="MediaControls"
                Panel.ZIndex="5"
                Width="316"
                Height="78"
                Margin="0,0,0,7"
                Padding="7"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                BorderBrush="{StaticResource FloatGlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="MediaControlsLayoutScale" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
            <Border.Background>
                <StaticResource ResourceKey="FloatGlassBrush" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14"
                                  Color="#FF176A90"
                                  Direction="270"
                                  Opacity="0.26"
                                  ShadowDepth="4" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="MediaControlsTranslate" Y="8" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="6"
                        Margin="-6"
                        BorderBrush="{StaticResource FloatGlassHighlightBrush}"
                        BorderThickness="1"
                        CornerRadius="23"
                        IsHitTestVisible="False" />

                <Border x:Name="TrackArtworkHost"
                        Grid.Column="0"
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="15"
                        ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#3A8FD2F2" />
                            <GradientStop Offset="1" Color="#2A63B4F2" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,52,52"
                                               RadiusX="15"
                                               RadiusY="15" />
                        </Grid.Clip>
                        <Image x:Name="TrackArtworkImage"
                               Stretch="UniformToFill"
                               Visibility="Collapsed" />
                        <Viewbox x:Name="TrackArtworkPlaceholder"
                                 Width="26"
                                 Height="20"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Canvas Width="14"
                                    Height="10">
                                <Path Data="M2.5,10 V6.5 M7,10 V2.5 M11.5,10 V4.5"
                                      Stroke="{StaticResource FloatAccentInkBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox x:Name="TrackEqBadge"
                                 Width="14"
                                 Height="10"
                                 Margin="0,0,5,5"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Visibility="Collapsed">
                            <Canvas Width="14"
                                    Height="10">
                                <Path Data="M2.5,10 V6.5 M7,10 V2.5 M11.5,10 V4.5"
                                      Stroke="White"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <Border BorderBrush="#8CFFFFFF"
                                BorderThickness="1"
                                CornerRadius="15"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Grid x:Name="TrackInfoBubble"
                      Grid.Column="1"
                      Margin="12,2,6,2"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      AutomationProperties.Name="当前歌曲">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TrackTitleText"
                               Foreground="{StaticResource FloatInkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Left"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackArtistText"
                               Grid.Row="1"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource FloatMutedBrush}"
                               FontSize="10"
                               TextAlignment="Left"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackTimelineText"
                               Grid.Row="2"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource FloatMutedBrush}"
                               FontSize="9.5"
                               TextAlignment="Left"
                               Visibility="Collapsed" />
                </Grid>

                <Button x:Name="PreviousTrackButton"
                        Grid.Column="2"
                        Style="{StaticResource MediaIconButtonStyle}"
                        Click="OnPreviousTrackClick"
                        AutomationProperties.Name="上一首"
                        ToolTip="上一首（Ctrl+Alt+Left）">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="M6.5,5 V19 M18,5 L9.5,12 L18,19 Z"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2.3"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Grid Grid.Column="3"
                      Width="44"
                      Height="44">
                    <Ellipse x:Name="PlayStateHalo"
                             Width="46"
                             Height="46"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Panel.ZIndex="0"
                             Fill="#2466CCFF"
                             IsHitTestVisible="False"
                             Visibility="Collapsed" />
                    <Button x:Name="TogglePlayPauseButton"
                            Panel.ZIndex="1"
                            Style="{StaticResource MediaPrimaryButtonStyle}"
                            Click="OnTogglePlayPauseClick"
                            AutomationProperties.Name="播放或暂停"
                            ToolTip="播放 / 暂停（Ctrl+Alt+P）">
                        <Grid Width="24" Height="24">
                            <Viewbox x:Name="PlayGlyph">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M8,4.5 L20,12 L8,19.5 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                            <Viewbox x:Name="PauseGlyph" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M7,5 H11 V19 H7 Z M13,5 H17 V19 H13 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>
                    <Ellipse x:Name="TrackProgressRingTrack"
                             Width="39"
                             Height="39"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Panel.ZIndex="2"
                             Fill="Transparent"
                             Stroke="#59FFFFFF"
                             StrokeThickness="2.5"
                             IsHitTestVisible="False"
                             Visibility="Collapsed" />
                    <Path x:Name="TrackProgressRing"
                          Width="44"
                          Height="44"
                          Panel.ZIndex="3"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="Transparent"
                          Stroke="{StaticResource FloatAccentDeepBrush}"
                          StrokeThickness="2.5"
                          StrokeStartLineCap="Round"
                          IsHitTestVisible="False"
                          Visibility="Collapsed" />
                </Grid>

                <Button x:Name="NextTrackButton"
                        Grid.Column="4"
                        Style="{StaticResource MediaIconButtonStyle}"
                        Click="OnNextTrackClick"
                        AutomationProperties.Name="下一首"
                        ToolTip="下一首（Ctrl+Alt+Right）">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="M17.5,5 V19 M6,5 L14.5,12 L6,19 Z"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2.3"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="CloudMusicVolumeButton"
                        Grid.Column="5"
                        Style="{StaticResource MediaIconButtonStyle}"
                        Click="OnCloudMusicVolumeClick"
                        AutomationProperties.Name="网易云音乐独立音量"
                        ToolTip="调节网易云音乐音量（不影响其他应用）">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4,9.5 H8 L13,5.5 V18.5 L8,14.5 H4 Z"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2.3"
                                  StrokeLineJoin="Round" />
                            <Path Data="M16,9 C17,9.8 17.6,10.8 17.6,12 C17.6,13.2 17,14.2 16,15 M18.6,6.4 C20.4,7.9 21.5,9.8 21.5,12 C21.5,14.2 20.4,16.1 18.6,17.6"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

            </Grid>
        </Border>

        <Popup x:Name="CloudMusicVolumePopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=CloudMusicVolumeButton}"
               VerticalOffset="-4"
               AllowsTransparency="True"
               StaysOpen="False"
               Closed="OnCloudMusicVolumePopupClosed">
            <Grid>
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      Color="#FF176A90"
                                      Direction="270"
                                      Opacity="0.26"
                                      ShadowDepth="4" />
                </Grid.Effect>
                <Border Width="54"
                        Margin="0,0,0,4"
                        Padding="8,9,8,8"
                        Background="{StaticResource FloatGlassBrush}"
                        BorderBrush="{StaticResource FloatGlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="CloudMusicVolumeValueText"
                                   Margin="0,0,0,2"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource FloatAccentInkBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="--%" />
                        <Grid x:Name="CloudMusicVolumeDragSurface"
                              Width="30"
                              Height="116"
                              Background="Transparent"
                              PreviewMouseLeftButtonDown="OnCloudMusicVolumeSliderPreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnCloudMusicVolumeSliderPreviewMouseMove"
                              PreviewMouseLeftButtonUp="OnCloudMusicVolumeSliderPreviewMouseLeftButtonUp">
                            <Slider x:Name="CloudMusicVolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True"
                                    IsHitTestVisible="False"
                                    Style="{StaticResource CloudMusicVerticalVolumeSliderStyle}"
                                    ValueChanged="OnCloudMusicVolumeSliderValueChanged"
                                    AutomationProperties.Name="网易云音乐竖向音量" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Path Data="M0,0 L5,5 L10,0"
                      Fill="{StaticResource FloatGlassBrush}"
                      Stroke="{StaticResource FloatGlassBorderBrush}"
                      StrokeThickness="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom" />
            </Grid>
        </Popup>

        <Button x:Name="EdgeDockHandle"
                Panel.ZIndex="20"
                Width="12"
                Height="78"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Focusable="False"
                IsHitTestVisible="True"
                Visibility="Collapsed"
                MouseEnter="OnEdgeDockHandleMouseEnter"
                AutomationProperties.Name="唤出洛天依">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Window>
